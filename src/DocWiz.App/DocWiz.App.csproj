<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ASP.NET Core shared framework: the editor is a local web app hosted by the CLI (ADR-002) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals (StorePathOverride seam) to the test project so pinning
         tests can redirect the store path without touching %APPDATA%. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DocWiz.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocWiz.Core\DocWiz.Core.csproj" />
    <ProjectReference Include="..\DocWiz.Build\DocWiz.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor UI (incl. vendored ProseMirror) embedded so the published exe
         needs no loose files. LogicalName preserves the real path: default naming
         mangles dashes in directory names, breaking vendor/prosemirror/<pkg>/ lookups. -->
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
